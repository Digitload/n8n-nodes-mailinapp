{
	"name": "MailInApp AI assistant (MCP)",
	"nodes": [
		{
			"parameters": {
				"options": {}
			},
			"id": "6f0b4c1e-1a2b-4c3d-8e9f-000000000001",
			"name": "When chat message received",
			"type": "@n8n/n8n-nodes-langchain.chatTrigger",
			"typeVersion": 1.1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"options": {
					"systemMessage": "You are an email marketing assistant for one MailInApp account. Use the MailInApp tools to answer questions about contacts, campaign results, form responses and journeys, and to draft journeys when asked. Journeys you build are saved turned off: tell the user to review and turn them on in MailInApp. Never claim an email was sent: you have no tool that sends one."
				}
			},
			"id": "6f0b4c1e-1a2b-4c3d-8e9f-000000000002",
			"name": "AI Agent",
			"type": "@n8n/n8n-nodes-langchain.agent",
			"typeVersion": 2.2,
			"position": [260, 0]
		},
		{
			"parameters": {
				"model": {
					"__rl": true,
					"mode": "id",
					"value": "claude-sonnet-5-5"
				},
				"options": {}
			},
			"id": "6f0b4c1e-1a2b-4c3d-8e9f-000000000003",
			"name": "Anthropic Chat Model",
			"type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
			"typeVersion": 1.3,
			"position": [140, 240]
		},
		{
			"parameters": {
				"endpointUrl": "https://mailinapp.com/api/mcp",
				"serverTransport": "httpStreamable",
				"authentication": "bearerAuth",
				"include": "selected",
				"includeTools": [
					"list_contact_lists",
					"get_contact_list_summary",
					"find_contacts",
					"list_projects",
					"get_email",
					"get_campaign_results",
					"get_form_responses",
					"list_segments",
					"list_journeys",
					"get_journey",
					"build_journey"
				],
				"options": {}
			},
			"id": "6f0b4c1e-1a2b-4c3d-8e9f-000000000004",
			"name": "MailInApp MCP",
			"type": "@n8n/n8n-nodes-langchain.mcpClientTool",
			"typeVersion": 1.2,
			"position": [340, 240]
		},
		{
			"parameters": {
				"resource": "contact",
				"operation": "get",
				"email": "={{ $fromAI('email', 'The email address of the contact to look up', 'string') }}"
			},
			"id": "6f0b4c1e-1a2b-4c3d-8e9f-000000000005",
			"name": "Find contact by email",
			"type": "n8n-nodes-mailinapp.mailInAppTool",
			"typeVersion": 1,
			"position": [540, 240]
		}
	],
	"connections": {
